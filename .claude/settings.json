{
  "permissions": {
    "allow": [
      "Bash(gitleaks *)",
      "Bash(mihomo -t *)",
      "Bash(mihomo -v)",
      "Bash(swift build *)",
      "Bash(swift test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*github.*__(push_files|create_or_update_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.sh\"",
            "timeout": 120,
            "statusMessage": "Проверка секретов (gitleaks)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
